<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_amoled"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Status, Latency, Route -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="● STANDBY"
            android:textColor="#888888"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_latency_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="53ms"
            android:textColor="#555555"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_route_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:fontFamily="monospace"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="MIC: INT"
            android:textColor="#AAAAAA"
            android:textSize="9sp" />
    </LinearLayout>

    <!-- Main Content Area: Category, Answer Excerpt, Romanian Guidance -->
    <LinearLayout
        android:id="@+id/widget_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_category_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="STEALTH VOICE COPILOT"
            android:textColor="#3DDC84"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_answer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="Ready for US freight dispatching &amp; billing interview prompts."
            android:textColor="#EEEEEE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_ro_guidance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Tap microphone or start listening."
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Footer Controls: Mic Toggle, Panic Wipe, Open App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_toggle_mic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingVertical="6dp"
            android:text="● MIC"
            android:textColor="#3DDC84"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_panic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_widget_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="WIPE"
            android:textColor="#FF4444"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_chip"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="OPEN ↗"
            android:textColor="#AAAAAA"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
